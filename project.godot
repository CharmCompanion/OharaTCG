; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OharaTCG"
run/main_scene="uid://cfqu7c3fgy2vg"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Background="*res://scenes/Background.tscn"
Updater="*res://scripts/ui/Updater.gd"
ContentSync="*res://scripts/managers/ContentSync.gd"
CardDatabase="*res://scripts/managers/CardDatabase.gd"
DataManager="*res://scripts/managers/DataManager.gd"
Lan="*res://scripts/net/Lan.gd"
ChatManager="*res://scripts/ui/ChatManager.gd"
AltArtManager="*res://scripts/managers/AltArtManager.gd"
RulesManager="*res://scripts/managers/RulesManager.gd"
DeckManager="*res://scripts/managers/DeckManager.gd"
CardTweenManager="*res://scripts/ui/CardTweenManager.gd"
CollectionManager="*res://scripts/managers/CollectionManager.gd"
ProfileManager="*res://scripts/managers/ProfileManager.gd"
Social="*res://scripts/managers/Social.gd"
Accounts="*res://scripts/net/Accounts.gd"

[debug]

gdscript/warnings/inference_on_variant=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"

[gui]

theme/custom_constant/ui_scale=9.0

